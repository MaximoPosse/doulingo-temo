# Credenciales PÚBLICAS del cliente Supabase.
#
# Copiá este archivo a `.env` y completá los valores de tu proyecto
# (Supabase → Project Settings → API):
#   - Project URL               -> VITE_SUPABASE_URL
#   - publishable key (sb_...)  -> VITE_SUPABASE_PUBLISHABLE_KEY
#
# En proyectos antiguos la clave pública se llama "anon key":
#   - anon public key           -> VITE_SUPABASE_ANON_KEY
#
# Estas claves son públicas por diseño (solo lectura de contenido publicado y
# llamada a la RPC check_answer). NUNCA uses la clave secreta
# (service_role / sb_secret_...) en el frontend.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
