# Credenciales PÚBLICAS del cliente Supabase.
#
# Copiá este archivo a `.env` y completá los valores de tu proyecto
# (Supabase → Project Settings → API):
#   - Project URL        -> VITE_SUPABASE_URL
#   - anon public key    -> VITE_SUPABASE_ANON_KEY
#
# La anon key es pública por diseño (solo lectura de contenido publicado y
# llamada a la RPC check_answer). NUNCA uses la service_role key aquí.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
